#include <iostream>
#include <algorithm>
using namespace std;

struct Edge {
    int u, v, cost;
};

bool compare(Edge a, Edge b) {
    return a.cost < b.cost;
}

int parent[100];

int find(int x) {
    if (parent[x] == x)
        return x;
    return parent[x] = find(parent[x]);
}

int main() {
    int n, m, total = 0, count = 0;
    Edge e[100];

    cout << "Enter computers and links: ";
    cin >> n >> m;

    cout << "Enter source destination cost:\n";
    for (int i = 0; i < m; i++)
        cin >> e[i].u >> e[i].v >> e[i].cost;

    sort(e, e + m, compare);

    for (int i = 0; i < n; i++)
        parent[i] = i;

    cout << "Selected cable links:\n";

    for (int i = 0; i < m && count < n - 1; i++) {
        int a = find(e[i].u);
        int b = find(e[i].v);

        if (a != b) {
            parent[a] = b;
            cout << e[i].u << " - "
                 << e[i].v << " : "
                 << e[i].cost << endl;

            total += e[i].cost;
            count++;
        }
    }

    if (count == n - 1)
        cout << "Total cable cost = " << total;
    else
        cout << "Network cannot connect all computers.";

    return 0;
}
